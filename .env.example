# Copy to .env and fill in. Empty means "not set".

CHIRPO_ENV=development              # development | test | production
CHIRPO_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
CHIRPO_LOG_FORMAT=auto              # auto | json | console
# Inside Docker use db:5432 and redis:6379 instead of localhost.
CHIRPO_DATABASE_URL=postgresql+asyncpg://chirpo:chirpo@localhost:5433/chirpo
CHIRPO_REDIS_URL=redis://localhost:6380/0
# Required. Generate: cd backend && uv run python -c "from chirpo.security import generate_key; print(generate_key())"
# Rotation: new_key,old_key
CHIRPO_ENCRYPTION_KEY=
CHIRPO_PUBLIC_URL=                  # https URL, needed only for webhook modes
CHIRPO_TRUSTED_PROXIES=127.0.0.1    # proxies allowed to set X-Forwarded-* (Docker Compose sets *)
CHIRPO_SENTRY_DSN=

CHIRPO_TELEGRAM_BOT_TOKEN=
CHIRPO_TELEGRAM_MODE=polling        # polling | webhook
# Webhook mode only. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CHIRPO_TELEGRAM_WEBHOOK_SECRET=

# GitHub App: see docs/github-app.md. Save its key as secrets/github-app.pem (git-ignored).
# The path is for commands run on your machine; Docker mounts secrets/ and sets its own path.
CHIRPO_GITHUB_APP_ID=
CHIRPO_GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/chirpo/secrets/github-app.pem
# The App's Client ID (public, starts with "Iv"), for /iam. Also tick "Enable Device Flow" in the App.
CHIRPO_GITHUB_APP_CLIENT_ID=
CHIRPO_GITHUB_WEBHOOK_SECRET=
CHIRPO_GITHUB_EVENTS_MODE=polling   # polling | webhook
CHIRPO_GITHUB_DEV_TOKEN=            # development only, refused in production

# Gemini key from https://aistudio.google.com/apikey. On the free tier Google may use what is sent
# (chat messages) to improve its products; use a paid key if that matters to your team.
CHIRPO_LLM_PROVIDER=gemini
CHIRPO_LLM_MODEL=                   # empty: gemini-3.6-flash (or e.g. gemini-3.5-flash-lite)
CHIRPO_LLM_API_KEY=

# Docker Compose only
COMPOSE_FILE=docker-compose.dev.yml
POSTGRES_USER=chirpo
POSTGRES_PASSWORD=chirpo
POSTGRES_DB=chirpo
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
ADMINER_HOST_PORT=8081
CADDY_HOST_PORT=8080
