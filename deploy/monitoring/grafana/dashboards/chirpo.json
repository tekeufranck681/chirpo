{
  "uid": "chirpo",
  "title": "chirpo",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests per second, by route",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(chirpo_http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP errors (5xx) per second",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(chirpo_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Jobs per second, by result",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (function, result) (rate(chirpo_jobs_total[5m]))",
          "legendFormat": "{{function}} {{result}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Job duration, 95th percentile",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, function) (rate(chirpo_job_seconds_bucket[5m])))",
          "legendFormat": "{{function}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Jobs waiting in the queue",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "targets": [{ "refId": "A", "expr": "chirpo_queue_length", "legendFormat": "waiting" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM calls per hour, by result",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, result) (increase(chirpo_llm_calls_total[1h]))",
          "legendFormat": "{{model}} {{result}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM tokens per hour",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, direction) (increase(chirpo_llm_tokens_total[1h]))",
          "legendFormat": "{{model}} {{direction}}"
        }
      ]
    }
  ]
}
